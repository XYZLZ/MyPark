{
  "name": "mypark",
  "version": "0.0.0",
  "private": true,
  "description": "MyPark monorepo: Go API, Next.js web app, Expo mobile app and shared contracts.",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/contracts"
  ],
  "scripts": {
    "test:scripts": "node --test \"scripts/**/*.test.*\"",
    "gen:contracts": "npm run gen -w packages/contracts",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:react": "node scripts/check-single-react.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "openapi-typescript": {
      "typescript": "6.0.3"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
